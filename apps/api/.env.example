# Copy to apps/api/.env for local development.

# Host port 5433 locally (a native Postgres owns 5432 on some machines).
# In the container/compose network the host is `db` and the port is 5432.
DATABASE_URL=postgres://runturf:runturf_dev@localhost:5433/runturf

# Must be >=16 chars. Generate a strong random value for any real deployment,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Comma-separated list of allowed web origins.
CORS_ORIGIN=http://localhost:5173

# development | test | production. Production disables demo seeding, request
# pretty-printing, and enables `trust proxy`.
NODE_ENV=development

# Optional override for demo-account seeding. Unset = demo users in non-prod
# only. Set to `true` to force them (e.g. a preview box), `false` to suppress.
# SEED_DEMO=false
